  "privacyPolicyTitle": "Privacy Policy",
  "@privacyPolicyTitle": {},
  "privacyPolicyLastUpdated": "Effective date: January 1, 2025",
  "@privacyPolicyLastUpdated": {},
  "privacyPolicyIntro": "Cortisol Zero (\"we\", \"our\", \"app\") is committed to protecting your privacy.",
  "@privacyPolicyIntro": {},
  "privacyPolicyDataCollectedTitle": "1. Data We Collect",
  "@privacyPolicyDataCollectedTitle": {},
  "privacyPolicyDataCollectedBody": "Cortisol Zero does NOT collect any personal data. All data (journal entries, sleep records, breathing session history, and app-blocker schedules) is stored exclusively on your device and is never transmitted to any server.",
  "@privacyPolicyDataCollectedBody": {},
  "privacyPolicyPermissionsTitle": "2. Permissions Used",
  "@privacyPolicyPermissionsTitle": {},
  "privacyPolicyPermissionsBody": "• Accessibility Service — detects which app is on screen (package name only) to apply your blocker schedule. It does NOT read your messages, passwords, or personal data.\n\n• Display Over Other Apps — shows a calming overlay screen when a blocked app is opened during focus hours.\n\n• Usage Stats — reads app usage data to activate blocking rules. This data stays on your device only.\n\n• Foreground Service — keeps the blocker active in the background during your scheduled focus window.\n\nNone of these permissions are used to collect, transmit, or share data with us or any third party.",
  "@privacyPolicyPermissionsBody": {},
  "privacyPolicyPurchasesTitle": "3. In-App Purchases",
  "@privacyPolicyPurchasesTitle": {},
  "privacyPolicyPurchasesBody": "Purchases are processed by Google Play. We do not store payment information. We receive only a purchase token to verify your PRO status.",
  "@privacyPolicyPurchasesBody": {},
  "privacyPolicyThirdPartyTitle": "4. Third-Party Services",
  "@privacyPolicyThirdPartyTitle": {},
  "privacyPolicyThirdPartyBody": "We do not integrate analytics, advertising SDKs, or crash reporting services that collect personal data. The app contains no tracking code.",
  "@privacyPolicyThirdPartyBody": {},
  "privacyPolicyChildrenTitle": "5. Children",
  "@privacyPolicyChildrenTitle": {},
  "privacyPolicyChildrenBody": "Cortisol Zero does not knowingly collect information from children under 13. The app is rated for general audiences.",
  "@privacyPolicyChildrenBody": {},
  "privacyPolicyContactTitle": "6. Contact",
  "@privacyPolicyContactTitle": {},
  "privacyPolicyContactBody": "For privacy questions contact us at: cartizolzero@gmail.com",
  "@privacyPolicyContactBody": {},
  "privacyPolicyChangesTitle": "7. Changes",
  "@privacyPolicyChangesTitle": {},
  "privacyPolicyChangesBody": "We may update this policy. Continued use of the app after updates constitutes acceptance of the revised policy.",
  "@privacyPolicyChangesBody": {},
